<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Takeover is intentionally NOT sandboxed: its job is to manage files, symlinks
	and `defaults` domains across the whole user account. The previous entries
	(app-scope bookmarks + a temporary-exception read/write for /Users/) were
	App-Sandbox-only keys and did nothing without com.apple.security.app-sandbox,
	while still drawing extra Gatekeeper/notarization scrutiny. They are removed.

	Full Disk Access is granted by the user in System Settings > Privacy &
	Security, not via an entitlement.
	-->
</dict>
</plist>
